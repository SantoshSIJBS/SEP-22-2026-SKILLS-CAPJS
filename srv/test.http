### Metadata of the serivce
http://localhost:4004/odata/v4/catalog/$metadata


### $top, $skip, $count, $select, $filter, $expand

### Read the data from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv

### Read the data from Product Service
GET http://localhost:4004/odata/v4/catalog/ProductSrv

### Read first 10 employees from Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$top=10

### Read 11th to 20th record of employee by skiping first 10 records
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$top=10&$skip=10

### Read number of employees from the service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv/$count

### Read specific details of an employee
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$select=nameFirst,nameLast,phoneNumber,email,accountNumber,salaryAmount

### Read only female employee details
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$filter=gender eq 'F'

### eq -> Equals to, gt -> Greater Than, lt -> Lesser Than, ge -> Greater Than or Equal to, le -> Lesser Than or Equal to

### Read employee details where their salary is more than 50000 USD
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv?$filter=salaryAmount gt 50000

### Read all header and item information from any service
GET http://localhost:4004/odata/v4/catalog/POSrv?$expand=Items


### Read a specific employee from the Employee Service
GET http://localhost:4004/odata/v4/catalog/EmployeeSrv(02BD2137-0890-1EEA-A6C2-BB55C198C7FB)


### Insert a record into the Employee Service
POST http://localhost:4004/odata/v4/catalog/EmployeeSrv
Content-Type: application/json

{
  "Currency_code": "USD",
  "ID": "02BD2137-0890-1EEA-A6C2-BB55C198C7DD",
  "accountNumber": "87654311",
  "bandId": "66669999",
  "bankName": "My Bank of New York",
  "email": "john.senna@itelo.info",
  "gender": "M",
  "language": "E",
  "loginName": "JSENNA",
  "nameFirst": "John",
  "nameInitials": null,
  "nameLast": "Senna",
  "nameMiddle": null,
  "phoneNumber": null,
  "salaryAmount": "65518.00"
}


### Update salary of an employee
PUT http://localhost:4004/odata/v4/catalog/EmployeeSrv/02BD2137-0890-1EEA-A6C2-BB55C198C7CC
Content-Type: application/json

{
    "Currency_code" : "USD",
    "salaryAmount" : 80000
}


### Remove an employee from Employee Table
DELETE http://localhost:4004/odata/v4/catalog/EmployeeSrv/02BD2137-0890-1EEA-A6C2-BB55C198C7CC




