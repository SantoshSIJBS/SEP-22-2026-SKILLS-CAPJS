{
  "name": "purchaseorders",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3.0.2",
    "@sap/cds": "^10.0.6",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-poaapp": "cds watch --open poaapp.poaapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-poapplication": "cds watch --open poapplication/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employeeapp": "cds watch --open employeeapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy purchaseorders --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/poapplication"
  ],
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
